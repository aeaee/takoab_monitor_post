# ลิงก์โพสต์ในกลุ่ม Facebook ที่ต้องการเฝ้าดู
POST_URL=https://www.facebook.com/groups/YOUR_GROUP_ID/posts/YOUR_POST_ID/

# ระยะเวลารอระหว่างรอบการตรวจ (วินาที) 180 วินาที = 3 นาที
CHECK_INTERVAL=180

# ช่วงเวลาเปิดร้าน (เช่น 10:00-20:00) ถ้าปล่อยว่างจะตรวจตลอด 24 ชม.
OPERATING_HOURS=10:00-20:00

# ส่งข้อความสถานะปกติทุกรอบเข้า Telegram แบบไร้เสียง (Silent Notification ไม่สั่นเตือน)
SEND_IDLE_STATUS=true

# เปิด/ปิดการใช้ AI (true = ใช้ Gemini AI, false = สลับไปตรวจ Keyword ปกติในเครื่อง)
USE_AI=false

# (ทางเลือก) Gemini API Key หากต้องการให้ AI ช่วยวิเคราะห์ภาษาคน
GEMINI_API_KEY=

# (สำคัญ) ชื่อโปรไฟล์เฟสบุ๊คของคนขาย/คนตอบรับออเดอร์ (ใส่ได้หลายคน โดยคั่นด้วยเครื่องหมายจุลภาค , )
POST_AUTHOR_NAME=ชื่อคนขายคนที่1, ชื่อคนขายคนที่2

# รูปแบบแจ้งเตือนบนคอมพิวเตอร์: 'dialog' (เด้งกล่องข้อความ), 'banner' (มุมขวาบน), 'both' (ทั้งสองแบบ)
NOTIFICATION_STYLE=banner

# ระยะเวลาให้หน้าต่างแจ้งเตือนค้างไว้บนหน้าจอ (วินาที) ค่าเริ่มต้น 60 วินาที (ใส่ 0 เพื่อให้ค้างจนกว่าจะกดปุ่มปิด)
NOTIFICATION_DURATION=60

# คีย์เวิร์ดยืนยันการรับออเดอร์ (คั่นด้วยจุลภาค)
CONFIRM_KEYWORDS=รับออเดอร์,รับยอด,เรียบร้อย,รับแล้ว,จดแล้ว,ตอบแชท,ทักแชท,ส่งให้แล้ว,รับออเดอร์ค่ะ,รับออเดอร์ครับ,รับยอดค่ะ,รับยอดครับ,จดแล้วค่ะ,จดแล้วครับ

# Telegram แจ้งเตือนเข้ามือถือ (ใส่ได้หลาย Chat ID คั่นด้วยจุลภาค , หรือ Group ID)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
